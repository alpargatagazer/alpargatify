## Global options
{
    # Admin accesible only in this virtual network
    admin caddy-admin:2019
    # Enable per-host metrics
    metrics {
        per_host
    }

    # JSON logging (captured by Docker and tee'd to file via compose)
    log {
        format json
    }
}

<protocol>://<domain> {
    reverse_proxy navidrome:4533 {
        flush_interval -1
    }
}

<protocol>://<domain>:4533 {
    redir <protocol>://<domain>{uri} permanent
}

# WUD - Protected by internal auth only (Basic Auth header conflict prevents Caddy layer)
<protocol>://wud.<domain> {
    route {
        reverse_proxy wud:2999
    }
}

# Dozzle - Docker log viewer (protected by Caddy basicauth)
<protocol>://logs.<domain> {
    basicauth {
        <caddy_auth_user> <caddy_auth_password_hash>
    }
    route {
        reverse_proxy dozzle:8080 {
            flush_interval -1
        }
    }
}

<protocol>://grafana.<domain> {
    route {
        reverse_proxy grafana:3000
    }
}

<protocol>://syncthing.<domain> {
    route {
        reverse_proxy syncthing:8384
    }
}

<protocol>://filebrowser.<domain> {
    route {
        reverse_proxy filebrowser:8080
    }
}

<protocol>://picard.<domain> {
    basicauth {
        <picard_admin_user> <picard_caddy_password_hash>
    }
    route {
        reverse_proxy picard:5800
    }
}

# Metadata Remote - metadata editor (protected by Caddy basicauth, no internal auth)
<protocol>://mdrm.<domain> {
    basicauth {
        <caddy_auth_user> <caddy_auth_password_hash>
    }
    route {
        reverse_proxy metadata-remote:8338
    }
}

# Internal monitoring endpoints - do NOT expose to the internet
<protocol>://prometheus.<domain> {
    @allowed client_ip 127.0.0.1 172.16.0.0/8 192.168.0.0/16
    handle @allowed {
        reverse_proxy prometheus:9090
    }
    handle {
        abort
    }
}
